---
/**
 * categories/index.astro — 分类列表页
 *
 * 展示所有分类及其文章数量
 */
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { prisma } from '../../lib/prisma';

const categories = await prisma.category.findMany({
  include: {
    _count: { select: { posts: { where: { published: true } } } },
  },
  orderBy: { sortOrder: 'asc' },
});
---

<BaseLayout seo={{ title: '分类', description: '浏览所有分类' }}>
  <h1 class="text-2xl font-bold text-[var(--color-text-primary)] mb-6">分类</h1>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {categories.map(cat => (
      <a
        href={`/categories/${cat.slug}`}
        class="block p-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] hover:shadow-md hover:border-[var(--color-accent)] transition-all"
      >
        <h2 class="text-lg font-semibold text-[var(--color-text-primary)]">{cat.name}</h2>
        {cat.description && (
          <p class="text-sm text-[var(--color-text-secondary)] mt-1 line-clamp-2" title={cat.description}>{cat.description}</p>
        )}
        <p class="text-sm text-[var(--color-text-muted)] mt-2">
          {cat._count.posts} 篇文章
        </p>
      </a>
    ))}
  </div>
</BaseLayout>
