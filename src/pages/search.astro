---
/**
 * search.astro — 搜索页面
 *
 * 客户端搜索：页面加载时从 /api/search-index 获取所有文章 JSON，
 * 使用 Fuse.js 做模糊搜索，无需后端搜索服务。
 *
 * 类比 CV：这就像是把所有文章的特征向量预计算好存内存里，
 * 查询时直接做相似度匹配 — 只是这里用 Fuse.js 做文本模糊匹配。
 */
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout seo={{ title: '搜索', description: '搜索文章' }}>
  <h1 class="text-2xl font-bold text-[var(--color-text-primary)] mb-6">搜索</h1>

  <!-- 搜索输入框 -->
  <div class="relative mb-8">
    <input
      id="search-input"
      type="text"
      placeholder="输入关键词搜索文章..."
      class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent"
      autocomplete="off"
    />
  </div>

  <!-- 搜索结果 -->
  <div id="search-results" class="space-y-4">
    <p class="text-[var(--color-text-muted)] text-center py-8">输入关键词开始搜索...</p>
  </div>
</BaseLayout>

<!-- 搜索逻辑 (仅在客户端运行) -->
<script>
  import Fuse from 'fuse.js';

  interface PostDoc {
    id: number;
    slug: string;
    title: string;
    excerpt: string;
    category: string;
    date: string;
  }

  let fuse: Fuse<PostDoc> | null = null;

  // 加载搜索索引
  async function loadIndex(): Promise<void> {
    try {
      const resp = await fetch('/api/search-index');
      const posts: PostDoc[] = await resp.json();

      fuse = new Fuse(posts, {
        keys: ['title', 'excerpt', 'category'],
        threshold: 0.3,        // 越低越严格 (0=完全匹配, 1=匹配一切)
        includeScore: true,
      });

      // 如果 URL 带了搜索参数（如 /search?q=python），自动搜索
      const query = new URLSearchParams(window.location.search).get('q');
      if (query) {
        (document.getElementById('search-input') as HTMLInputElement).value = query;
        search(query);
      }
    } catch (err) {
      console.error('Failed to load search index:', err);
    }
  }

  function search(query: string): void {
    const container = document.getElementById('search-results');
    if (!container) return;

    if (!query.trim() || !fuse) {
      container.innerHTML = '<p class="text-[var(--color-text-muted)] text-center py-8">输入关键词开始搜索...</p>';
      return;
    }

    const results = fuse.search(query.trim());
    if (results.length === 0) {
      container.innerHTML = '<p class="text-[var(--color-text-muted)] text-center py-8">没有找到相关文章</p>';
      return;
    }

    container.innerHTML = results
      .map(({ item }) => `
      <a href="/posts/${item.id}/${item.slug}" class="block p-4 rounded-lg border border-[var(--color-border)] hover:shadow-md hover:border-[var(--color-accent)] transition-all bg-[var(--color-bg-card)]">
        <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">${escapeHtml(item.title)}</h3>
        <div class="flex items-center gap-2 mt-1 text-xs text-[var(--color-text-muted)]">
          ${item.category ? `<span class="text-[var(--color-accent)]">${escapeHtml(item.category)}</span>` : ''}
          ${item.date ? `<span>${escapeHtml(item.date)}</span>` : ''}
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] mt-2 line-clamp-2" title="${escapeHtml(item.excerpt)}">${escapeHtml(item.excerpt)}</p>
      </a>
    `).join('');
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // 初始化
  loadIndex();

  // 实时搜索（输入时触发）
  const input = document.getElementById('search-input');
  input?.addEventListener('input', (e) => {
    search((e.target as HTMLInputElement).value);
  });
</script>
