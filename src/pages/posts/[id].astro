---
/**
 * [id].astro — 文章详情页
 *
 * URL: /posts/123
 * 纯 ID 路由，无 slug。
 */
import BaseLayout from '../../components/layout/BaseLayout.astro';
import TagBadge from '../../components/blog/TagBadge.astro';
import CommentSection from '../../components/common/CommentSection.astro';
import { prisma } from '../../lib/prisma';
import { renderMarkdown } from '../../lib/markdown';
import { formatDateTime, toISODateTime } from '../../lib/utils';
import { decodeSession, hasRole } from '../../lib/auth';

const { id } = Astro.params;
const postId = parseInt(id!);

if (isNaN(postId)) {
  return Astro.redirect('/');
}

const post = await prisma.post.findUnique({
  where: { id: postId },
  include: {
    category: { select: { name: true, slug: true } },
    tags: { select: { tag: { select: { name: true, slug: true } } } },
  },
});

// 管理员可预览草稿
const session = decodeSession(Astro.cookies.get('session')?.value);
const isAdmin = session && hasRole(session.role, 'admin');

if (!post || (!post.published && !isAdmin)) {
  return Astro.redirect('/');
}

const isUpdated = post.updatedAt.getTime() - post.createdAt.getTime() > 1000;
const displayTime = isUpdated ? post.updatedAt : post.createdAt;
const timeLabel = isUpdated ? '最后一次更新于' : '发布时间';

const htmlContent = renderMarkdown(post.content);
---

<BaseLayout
  seo={{
    title: post.title,
    description: post.excerpt || undefined,
    type: 'article',
    publishedAt: toISODateTime(post.createdAt),
    image: post.coverImage || undefined,
    canonicalURL: new URL(`/posts/${post.id}`, Astro.url).href,
  }}
>
  <!-- 草稿提示 -->
  {!post.published && (
    <div class="mb-4 px-4 py-2 rounded-md bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 text-sm flex items-center gap-2">
      <span>📝</span> 这是一篇草稿，仅管理员可见
      <a href={`/admin/posts/${post.id}/edit`} class="ml-auto text-[var(--color-accent)] hover:underline">编辑</a>
    </div>
  )}

  <article>
    <a href="/" class="inline-flex items-center gap-1 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors mb-4">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      返回首页
    </a>

    <header class="mb-8">
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)] mb-4">
        {post.title}
      </h1>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--color-text-muted)]">
        <time datetime={toISODateTime(displayTime)}>
          {timeLabel} {formatDateTime(displayTime)}
        </time>
        {post.category && (
          <a href={`/categories/${post.category.slug}`} class="inline-flex items-center gap-1.5 hover:text-[var(--color-accent)] hover:underline transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
            {post.category.name}
          </a>
        )}
        {post.tags && post.tags.length > 0 && (
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
            <span>
              {post.tags.map((t, i) => (
                <>{i > 0 && ' / '}<a href={`/tags/${t.tag.slug}`} class="hover:text-[var(--color-accent)] hover:underline">{t.tag.name}</a></>
              ))}
            </span>
          </span>
        )}
      </div>
    </header>

    <div class="prose" set:html={htmlContent} />
  </article>

  <CommentSection />

  <button id="back-to-top" class="fixed bottom-6 right-6 z-40 p-3 rounded-full bg-[var(--color-accent)] text-white shadow-lg opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-[var(--color-accent-hover)]" aria-label="回到顶部">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
  </button>

  <script>
    const btn = document.getElementById('back-to-top');
    if (btn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          btn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          btn.classList.add('opacity-100', 'translate-y-0');
        } else {
          btn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          btn.classList.remove('opacity-100', 'translate-y-0');
        }
      });
      btn.addEventListener('click', () => window.scrollTo({top: 0, behavior: 'smooth'}));
    }
  </script>
</BaseLayout>
