---
/**
 * [slug].astro — 文章详情页
 *
 * 动态路由：文件名 [slug].astro 匹配 /posts/hello-world
 * Astro.params.slug 自动提取 URL 中的 "hello-world"
 */
import BaseLayout from '../../components/layout/BaseLayout.astro';
import TagBadge from '../../components/blog/TagBadge.astro';
import CommentSection from '../../components/common/CommentSection.astro';
import { prisma } from '../../lib/prisma';
import { renderMarkdown } from '../../lib/markdown';
import { formatDate, toISODate } from '../../lib/utils';

const { slug } = Astro.params;

// 查询文章（含关联的分类和标签）
const post = await prisma.post.findUnique({
  where: { slug },
  include: {
    category: { select: { name: true, slug: true } },
    tags: { select: { tag: { select: { name: true, slug: true } } } },
  },
});

// 文章不存在或未发布 → 404
if (!post || !post.published) {
  return Astro.redirect('/404');
}

// 渲染 Markdown → HTML
const htmlContent = renderMarkdown(post.content);
---

<BaseLayout
  seo={{
    title: post.title,
    description: post.excerpt || undefined,
    type: 'article',
    publishedAt: toISODate(post.createdAt),
    image: post.coverImage || undefined,
    canonicalURL: new URL(`/posts/${slug}`, Astro.url).href,
  }}
>
  <article>
    <!-- 头部信息 -->
    <header class="mb-8">
      {post.category && (
        <a
          href={`/categories/${post.category.slug}`}
          class="text-sm font-medium text-[var(--color-accent)] uppercase tracking-wide"
        >
          {post.category.name}
        </a>
      )}

      <h1 class="text-3xl font-bold text-[var(--color-text-primary)] mt-2 mb-4">
        {post.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-text-muted)]">
        <time datetime={toISODate(post.createdAt)}>
          {formatDate(post.createdAt)}
        </time>

        {post.tags && post.tags.length > 0 && (
          <span class="flex flex-wrap gap-1">
            {post.tags.map(({ tag }) => (
              <TagBadge name={tag.name} slug={tag.slug} />
            ))}
          </span>
        )}
      </div>
    </header>

    <!-- 文章正文 — 渲染后的 Markdown HTML -->
    <div class="prose" set:html={htmlContent} />
  </article>

  <!-- 评论区 -->
  <CommentSection />
</BaseLayout>
