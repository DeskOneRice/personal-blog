---
/**
 * index.astro — 首页
 *
 * 双栏布局：左栏文章列表 + 右栏侧边栏（每日一句/公告/分类/标签/签到日历）
 */
import BaseLayout from '../components/layout/BaseLayout.astro';
import HeroBanner from '../components/blog/HeroBanner.astro';
import InlineSearch from '../components/blog/InlineSearch.astro';
import PostCard from '../components/blog/PostCard.astro';
import Pagination from '../components/blog/Pagination.astro';
import Sidebar from '../components/blog/Sidebar.astro';
import { prisma } from '../lib/prisma';
import { toInt } from '../lib/utils';

const configs = await prisma.siteConfig.findMany();

const postsPerPage = toInt(configs.find(c => c.key === 'postsPerPage')?.value, 10);
const currentPage = toInt(Astro.url.searchParams.get('page'), 1);

const [totalPosts, posts] = await Promise.all([
  prisma.post.count({ where: { published: true } }),
  prisma.post.findMany({
    where: { published: true },
    include: {
      category: { select: { name: true, slug: true } },
      tags: { select: { tag: { select: { name: true, slug: true } } } },
    },
    orderBy: { createdAt: 'desc' },
    skip: (currentPage - 1) * postsPerPage,
    take: postsPerPage,
  }),
]);

const totalPages = Math.ceil(totalPosts / postsPerPage);

const siteName = configs.find(c => c.key === 'siteName')?.value || 'My Blog';
const siteDescription = configs.find(c => c.key === 'siteDescription')?.value || '';
---

<BaseLayout seo={{ title: siteName, description: siteDescription }} hasBanner>
  <HeroBanner slot="banner" />

  <div class="flex flex-col lg:flex-row gap-6">
    <!-- 左栏：侧边栏 -->
    <div class="w-full lg:w-72 flex-shrink-0 order-1 lg:order-none">
      <Sidebar />
    </div>

    <!-- 右栏：文章列表 -->
    <div class="flex-1 min-w-0 space-y-6">
      <InlineSearch />
      {posts.length === 0 ? (
        <div class="text-center py-16">
          <h2 class="text-xl font-bold text-[var(--color-text-secondary)]">还没有文章</h2>
          <p class="text-[var(--color-text-muted)] mt-2">敬请期待...</p>
        </div>
      ) : (
        posts.map(post => (
          <div class="post-card-wrapper" data-post-id={post.id}>
            <PostCard post={post} />
          </div>
        ))
      )}

      <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/" />
    </div>
  </div>
</BaseLayout>
