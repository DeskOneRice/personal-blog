---
/**
 * /admin/categories — 分类管理
 */
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { prisma } from '../../lib/prisma';
import type { SessionUser } from '../../lib/auth';

const user = Astro.locals.user as SessionUser | undefined;

const categories = await prisma.category.findMany({
  include: { _count: { select: { posts: true } } },
  orderBy: { sortOrder: 'asc' },
});
---

<AdminLayout title="分类管理" user={user ?? null}>
  <!-- 添加分类 -->
  <div class="flex gap-2 mb-6">
    <input id="new-cat-name" type="text" placeholder="新分类名称"
      class="flex-1 px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
    <input id="new-cat-desc" type="text" placeholder="描述 (可选)"
      class="flex-1 px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] hidden sm:block" />
    <button id="add-btn" class="px-4 py-2 rounded-md bg-[var(--color-accent)] text-white text-sm">添加</button>
  </div>

  <!-- 分类列表 -->
  <div class="space-y-2">
    {categories.map(cat => (
      <div class="flex items-center gap-2 p-3 bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)]">
        <div class="flex-1 min-w-0">
          <span class="font-medium text-[var(--color-text-primary)]">{cat.name}</span>
          {cat.description && (
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5 line-clamp-2" title={cat.description!}>{cat.description}</p>
          )}
        </div>
        <span class="text-xs text-[var(--color-text-muted)] hidden sm:inline">{cat._count.posts} 篇</span>
        <button class="text-sm text-[var(--color-accent)] hover:underline edit-btn"
          data-id={cat.id} data-name={cat.name} data-desc={cat.description || ''}>编辑</button>
        <button class="text-sm text-red-500 hover:underline delete-btn" data-id={cat.id} data-name={cat.name}>删除</button>
      </div>
    ))}
  </div>

  <!-- 编辑弹窗 -->
  <dialog id="edit-dialog" class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-primary)] p-6 shadow-lg">
    <h3 class="text-lg font-semibold mb-4">编辑分类</h3>
    <input id="edit-id" type="hidden" />
    <div class="space-y-3">
      <div>
        <label class="text-sm">名称</label>
        <input id="edit-name" type="text" class="w-full px-3 py-2 mt-1 rounded-md border border-[var(--color-border)]" />
      </div>
      <div>
        <label class="text-sm">描述</label>
        <input id="edit-desc" type="text" class="w-full px-3 py-2 mt-1 rounded-md border border-[var(--color-border)]" />
      </div>
      <div class="flex gap-2 justify-end">
        <button id="edit-cancel" class="px-4 py-2 rounded-md border border-[var(--color-border)] text-sm">取消</button>
        <button id="edit-save" class="px-4 py-2 rounded-md bg-[var(--color-accent)] text-white text-sm">保存</button>
      </div>
    </div>
  </dialog>

  <script>
    // 添加分类
    document.getElementById('add-btn')?.addEventListener('click', async () => {
      const name = (document.getElementById('new-cat-name') as HTMLInputElement).value.trim();
      if (!name) return alert('请输入分类名');
      const desc = (document.getElementById('new-cat-desc') as HTMLInputElement).value.trim();

      const resp = await fetch('/api/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description: desc || null }),
      });
      if (resp.ok) window.location.reload();
      else alert('添加失败');
    });

    // 编辑弹窗
    const dialog = document.getElementById('edit-dialog') as HTMLDialogElement;
    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        (document.getElementById('edit-id') as HTMLInputElement).value = el.dataset.id!;
        (document.getElementById('edit-name') as HTMLInputElement).value = el.dataset.name!;
        (document.getElementById('edit-desc') as HTMLInputElement).value = el.dataset.desc!;
        dialog.showModal();
      });
    });
    document.getElementById('edit-cancel')?.addEventListener('click', () => dialog.close());
    document.getElementById('edit-save')?.addEventListener('click', async () => {
      const id = (document.getElementById('edit-id') as HTMLInputElement).value;
      const name = (document.getElementById('edit-name') as HTMLInputElement).value.trim();
      const description = (document.getElementById('edit-desc') as HTMLInputElement).value.trim();
      const resp = await fetch(`/api/categories?id=${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description: description || null }),
      });
      if (resp.ok) window.location.reload();
      else alert('更新失败');
    });

    // 删除
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        if (!confirm(`确定删除分类「${el.dataset.name}」？`)) return;
        const resp = await fetch(`/api/categories?id=${el.dataset.id}`, { method: 'DELETE' });
        if (resp.ok) window.location.reload();
        else alert('删除失败');
      });
    });
  </script>
</AdminLayout>
