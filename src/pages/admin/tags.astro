---
/**
 * /admin/tags — 标签管理
 */
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { prisma } from '../../lib/prisma';
import type { SessionUser } from '../../lib/auth';

const user = Astro.locals.user as SessionUser | undefined;

const tags = await prisma.tag.findMany({
  include: { _count: { select: { posts: true } } },
  orderBy: { name: 'asc' },
});
---

<AdminLayout title="标签管理" user={user ?? null}>
  <div class="flex gap-2 mb-6">
    <input id="new-tag-name" type="text" placeholder="新标签名称"
      class="flex-1 max-w-xs px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
    <button id="add-btn" class="px-4 py-2 rounded-md bg-[var(--color-accent)] text-white text-sm">添加</button>
  </div>

  <div class="flex flex-wrap gap-2">
    {tags.map(tag => (
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-sm">
        <span class="text-[var(--color-text-primary)]">{tag.name}</span>
        <span class="text-xs text-[var(--color-text-muted)]">({tag._count.posts})</span>
        <button class="text-[var(--color-accent)] hover:underline edit-btn text-xs"
          data-id={tag.id} data-name={tag.name}>编辑</button>
        <button class="text-red-500 hover:underline delete-btn text-xs"
          data-id={tag.id} data-name={tag.name}>删除</button>
      </div>
    ))}
  </div>

  <script>
    document.getElementById('add-btn')?.addEventListener('click', async () => {
      const name = (document.getElementById('new-tag-name') as HTMLInputElement).value.trim();
      if (!name) return alert('请输入标签名');
      const resp = await fetch('/api/tags', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      if (resp.ok) window.location.reload();
      else alert('添加失败');
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const newName = prompt('编辑标签名', el.dataset.name);
        if (!newName || newName === el.dataset.name) return;
        const resp = await fetch(`/api/tags?id=${el.dataset.id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: newName }),
        });
        if (resp.ok) window.location.reload();
        else alert('更新失败');
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        if (!confirm(`删除标签「${el.dataset.name}」？`)) return;
        const resp = await fetch(`/api/tags?id=${el.dataset.id}`, { method: 'DELETE' });
        if (resp.ok) window.location.reload();
        else alert('删除失败');
      });
    });
  </script>
</AdminLayout>
