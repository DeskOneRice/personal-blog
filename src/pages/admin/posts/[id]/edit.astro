---
/**
 * /admin/posts/[id]/edit — 编辑文章
 *
 * 页面加载后从 /api/posts/[id] 获取文章数据并填充表单。
 * 服务端仅获取分类和标签列表（用于下拉框），文章数据由客户端异步加载。
 */
import AdminLayout from '../../../../components/layout/AdminLayout.astro';
import MarkdownEditor from '../../../../components/admin/MarkdownEditor.astro';
import { prisma } from '../../../../lib/prisma';
import type { SessionUser } from '../../../../lib/auth';

const user = Astro.locals.user as SessionUser | undefined;

const [categories, tags] = await Promise.all([
  prisma.category.findMany({ orderBy: { sortOrder: 'asc' } }),
  prisma.tag.findMany({ orderBy: { name: 'asc' } }),
]);

const postId = Astro.params.id;
---

<AdminLayout title="编辑文章" user={user ?? null}>
  <div id="loading" class="text-center py-8 text-[var(--color-text-muted)]" data-post-id={postId}>加载中...</div>

  <form id="post-form" class="hidden max-w-3xl space-y-5">
    <div>
      <label for="title" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">标题 *</label>
      <input id="title" type="text" required
        class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
    </div>

    <div>
      <label for="slug" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">Slug *</label>
      <input id="slug" type="text" required
        class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="category" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">分类</label>
        <select id="category"
          class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]">
          <option value="">无分类</option>
          {categories.map(c => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">标签</label>
        <div id="tags-container" class="flex flex-wrap gap-2 max-h-28 overflow-y-auto p-2 border border-[var(--color-border)] rounded-md">
          {tags.map(tag => (
            <label class="flex items-center gap-1 text-sm">
              <input type="checkbox" name="tags" value={tag.id} class="rounded" />
              {tag.name}
            </label>
          ))}
        </div>
      </div>
    </div>

    <div>
      <label for="coverImage" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">封面图 URL</label>
      <input id="coverImage" type="url"
        class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
        placeholder="https://example.com/image.jpg" />
    </div>

    <div>
      <label for="excerpt" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">摘要</label>
      <textarea id="excerpt" rows="2"
        class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"></textarea>
    </div>

    <!-- 内容 (Markdown 编辑器) -->
    <MarkdownEditor textareaId="content">
      <textarea id="content" rows="14" required
        class="w-full px-3 py-2 bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] font-mono text-sm focus:outline-none resize-y"></textarea>
    </MarkdownEditor>

    <div class="flex items-center gap-2">
      <input type="checkbox" id="published" class="rounded" />
      <label for="published" class="text-sm text-[var(--color-text-secondary)]">发布</label>
    </div>

    <div class="flex gap-3 pt-2">
      <button type="submit" class="px-6 py-2 rounded-md bg-[var(--color-accent)] text-white font-medium">更新</button>
      <a href="/admin/posts" class="px-6 py-2 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-secondary)]">取消</a>
    </div>

    <div id="form-error" class="text-sm text-red-500 hidden"></div>
  </form>

  <script>
    // 从 DOM 读取服务端注入的 postId
    const loadingEl = document.getElementById('loading');
    const postId = loadingEl?.dataset.postId || '';

    // 加载文章数据
    async function loadPost() {
      try {
        const resp = await fetch(`/api/posts/${postId}`);
        if (!resp.ok) throw new Error('加载失败');
        const post = await resp.json();

        // 填充表单
        (document.getElementById('title') as HTMLInputElement).value = post.title || '';
        (document.getElementById('slug') as HTMLInputElement).value = post.slug || '';
        (document.getElementById('coverImage') as HTMLInputElement).value = post.coverImage || '';
        (document.getElementById('excerpt') as HTMLTextAreaElement).value = post.excerpt || '';
        (document.getElementById('content') as HTMLTextAreaElement).value = post.content || '';
        (document.getElementById('published') as HTMLInputElement).checked = post.published;
        if (post.categoryId) {
          (document.getElementById('category') as HTMLSelectElement).value = post.categoryId.toString();
        }

        // 勾选标签
        const postTagIds = new Set(post.tags?.map((t: { tag: { id: number } }) => t.tag.id) || []);
        document.querySelectorAll<HTMLInputElement>('input[name="tags"]').forEach(cb => {
          cb.checked = postTagIds.has(parseInt(cb.value));
        });

        document.getElementById('loading')!.classList.add('hidden');
        document.getElementById('post-form')!.classList.remove('hidden');
      } catch {
        document.getElementById('loading')!.textContent = '加载失败，请刷新重试';
      }
    }

    loadPost();

    // 提交
    document.getElementById('post-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorEl = document.getElementById('form-error')!;

      const tagIds = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="tags"]:checked'))
        .map(cb => parseInt(cb.value));

      const categoryVal = (document.getElementById('category') as HTMLSelectElement).value;
      const categoryId = categoryVal ? parseInt(categoryVal) : null;

      const body = {
        title: (document.getElementById('title') as HTMLInputElement).value,
        slug: (document.getElementById('slug') as HTMLInputElement).value,
        content: (document.getElementById('content') as HTMLTextAreaElement).value,
        coverImage: (document.getElementById('coverImage') as HTMLInputElement).value.trim() || null,
        excerpt: (document.getElementById('excerpt') as HTMLTextAreaElement).value || null,
        categoryId,
        tagIds,
        published: (document.getElementById('published') as HTMLInputElement).checked,
      };

      try {
        const resp = await fetch(`/api/posts/${postId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (resp.ok) {
          window.location.href = '/admin/posts';
        } else {
          const data = await resp.json();
          errorEl.textContent = data.error || '更新失败';
          errorEl.classList.remove('hidden');
        }
      } catch {
        errorEl.textContent = '网络错误';
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
