---
/**
 * /admin/posts — 文章列表管理
 */
import AdminLayout from '../../../components/layout/AdminLayout.astro';
import { prisma } from '../../../lib/prisma';
import { formatDateTime } from '../../../lib/utils';
import type { SessionUser } from '../../../lib/auth';

const user = Astro.locals.user as SessionUser | undefined;

const posts = await prisma.post.findMany({
  include: {
    category: { select: { name: true } },
  },
  orderBy: { createdAt: 'desc' },
});
---

<AdminLayout title="文章管理" user={user ?? null}>
  <div class="mb-4">
    <div class="flex items-center gap-2">
      <a href="/admin/posts/new" class="inline-block px-4 py-2 rounded-md bg-[var(--color-accent)] text-white text-sm">+ 写文章</a>
      <button id="import-btn" class="inline-block px-4 py-2 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors">
        导入 MD
      </button>
      <input type="file" id="import-files" accept=".md" multiple class="hidden" />
      <span id="import-status" class="text-xs text-[var(--color-text-muted)]"></span>
    </div>
  </div>

  <div class="bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)] overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-[var(--color-bg-secondary)] border-b border-[var(--color-border)]">
        <tr>
          <th class="text-left px-4 py-3 font-medium text-[var(--color-text-secondary)]">标题</th>
          <th class="text-left px-4 py-3 font-medium text-[var(--color-text-secondary)] hidden sm:table-cell">分类</th>
          <th class="text-left px-4 py-3 font-medium text-[var(--color-text-secondary)] hidden md:table-cell">状态</th>
          <th class="text-left px-4 py-3 font-medium text-[var(--color-text-secondary)] hidden lg:table-cell">创建时间</th>
          <th class="text-left px-4 py-3 font-medium text-[var(--color-text-secondary)] hidden lg:table-cell">更新时间</th>
          <th class="text-right px-4 py-3 font-medium text-[var(--color-text-secondary)]">操作</th>
        </tr>
      </thead>
      <tbody>
        {posts.map(post => (
          <tr class="border-b border-[var(--color-border)] last:border-0 hover:bg-[var(--color-bg-secondary)]">
            <td class="px-4 py-3">
              <a href={`/posts/${post.id}`} class="font-medium text-[var(--color-text-primary)] hover:text-[var(--color-accent)]">
                {post.title}
              </a>
            </td>
            <td class="px-4 py-3 text-[var(--color-text-muted)] hidden sm:table-cell">
              {post.category?.name || '-'}
            </td>
            <td class="px-4 py-3 hidden md:table-cell">
              <span class={`px-2 py-0.5 rounded-full text-xs ${
                post.published
                  ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300'
                  : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300'
              }`}>
                {post.published ? '已发布' : '草稿'}
              </span>
            </td>
            <td class="px-4 py-3 text-[var(--color-text-muted)] text-xs hidden lg:table-cell">
              {formatDateTime(post.createdAt)}
            </td>
            <td class="px-4 py-3 text-[var(--color-text-muted)] text-xs hidden lg:table-cell">
              {formatDateTime(post.updatedAt)}
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <a href={`/admin/posts/${post.id}/edit`} class="text-sm text-[var(--color-accent)] hover:underline">编辑</a>
                <button
                  class="text-sm text-red-500 hover:underline delete-btn"
                  data-id={post.id}
                  data-title={post.title}
                >
                  删除
                </button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    // 导入 MD 文件
    const importBtn = document.getElementById('import-btn')!;
    const importFiles = document.getElementById('import-files') as HTMLInputElement;
    const importStatus = document.getElementById('import-status')!;

    importBtn.addEventListener('click', () => importFiles.click());

    importFiles.addEventListener('change', async () => {
      const files = importFiles.files;
      if (!files || files.length === 0) return;

      importStatus.textContent = `导入中...`;
      importBtn.setAttribute('disabled', 'true');

      const formData = new FormData();
      for (const f of files) formData.append('files', f);

      try {
        const resp = await fetch('/api/import-md', { method: 'POST', body: formData });
        const data = await resp.json();

        if (data.results) {
          // 统计
          const ok = data.results.filter((r: { status: string }) => r.status === 'ok').length;
          const skip = data.results.filter((r: { status: string }) => r.status === 'skip').length;
          importStatus.textContent = `导入 ${ok} 篇` + (skip > 0 ? `，跳过 ${skip} 篇` : '');
          importStatus.className = 'text-xs text-green-500';
          if (ok > 0) window.location.reload();
        } else {
          importStatus.textContent = data.error || '导入失败';
          importStatus.className = 'text-xs text-red-500';
        }
      } catch {
        importStatus.textContent = '网络错误';
        importStatus.className = 'text-xs text-red-500';
      } finally {
        importBtn.removeAttribute('disabled');
        importFiles.value = '';
      }
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        const title = (btn as HTMLElement).dataset.title;
        if (!confirm(`确定删除文章「${title}」？此操作不可撤销。`)) return;

        try {
          const resp = await fetch(`/api/posts/${id}`, { method: 'DELETE' });
          if (resp.ok) {
            window.location.reload();
          } else {
            alert('删除失败');
          }
        } catch {
          alert('网络错误');
        }
      });
    });
  </script>
</AdminLayout>
