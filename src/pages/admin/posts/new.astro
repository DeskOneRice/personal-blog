---
/**
 * /admin/posts/new — 创建新文章
 */
import AdminLayout from '../../../components/layout/AdminLayout.astro';
import MarkdownEditor from '../../../components/admin/MarkdownEditor.astro';
import TagSelect from '../../../components/admin/TagSelect.astro';
import ImageUpload from '../../../components/admin/ImageUpload.astro';
import { prisma } from '../../../lib/prisma';
import { slugify } from '../../../lib/utils';
import type { SessionUser } from '../../../lib/auth';

const user = Astro.locals.user as SessionUser | undefined;

const [categories, tags] = await Promise.all([
  prisma.category.findMany({ orderBy: { sortOrder: 'asc' } }),
  prisma.tag.findMany({ orderBy: { name: 'asc' } }),
]);
---

<AdminLayout title="写文章" user={user ?? null}>
  <form id="post-form" class="max-w-3xl space-y-5">
    <!-- 标题 -->
    <div>
      <label for="title" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">标题 *</label>
      <input id="title" type="text" required
        class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
        placeholder="文章标题" />
    </div>

    <!-- Slug -->
    <div>
      <label for="slug" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">Slug * (URL 标识)</label>
      <input id="slug" type="text" required
        class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
        placeholder="article-slug" />
      <p class="text-xs text-[var(--color-text-muted)] mt-1">输入标题后自动生成，也可手动修改</p>
    </div>

    <!-- 分类 & 标签 -->
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="category" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">分类</label>
        <select id="category"
          class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]">
          <option value="">无分类</option>
          {categories.map(c => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">标签</label>
        <TagSelect tags={tags} />
      </div>
    </div>

    <!-- 封面图 -->
    <div>
      <label for="coverImage" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">封面图 URL</label>
      <div class="flex gap-2">
        <input id="coverImage" type="text"
          class="flex-1 px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
          placeholder="https://example.com/image.jpg 或本地上传 (最大2MB)" />
        <ImageUpload targetInputId="coverImage" />
      </div>
    </div>

    <!-- 摘要 -->
    <div>
      <label for="excerpt" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">摘要</label>
      <textarea id="excerpt" rows="2"
        class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
        placeholder="文章摘要 (可选，留空则自动生成)"></textarea>
    </div>

    <!-- 内容 -->
    <div>
      <label class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1">内容 (Markdown)</label>
      <MarkdownEditor textareaId="content">
      <textarea id="content" rows="14" required
        class="w-full px-3 py-2 bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] font-mono text-sm focus:outline-none resize-y"
        placeholder="用 Markdown 写文章..."></textarea>
    </MarkdownEditor>
    </div>

    <!-- 发布状态 -->
    <div class="flex items-center gap-2">
      <input type="checkbox" id="published" class="rounded" />
      <label for="published" class="text-sm text-[var(--color-text-secondary)]">立即发布</label>
    </div>

    <!-- 按钮 -->
    <div class="flex gap-3 pt-2">
      <button type="submit" class="px-6 py-2 rounded-md bg-[var(--color-accent)] text-white font-medium">保存</button>
      <a href="/admin/posts" class="px-6 py-2 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-secondary)]">取消</a>
    </div>

    <div id="form-error" class="text-sm text-red-500 hidden"></div>
  </form>

  <script>
    const titleInput = document.getElementById('title') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;

    // 标题输入时自动生成 slug
    titleInput?.addEventListener('input', () => {
      // 如果 slug 为空或之前是自动生成的，自动更新
      slugInput.value = titleInput.value
        .toLowerCase()
        .replace(/[^\w一-鿿]+/g, '-')
        .replace(/^-+|-+$/g, '');
    });

    // 提交表单
    document.getElementById('post-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorEl = document.getElementById('form-error')!;

      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);

      const tagCheckboxes = form.querySelectorAll<HTMLInputElement>('input.tag-hidden[name="tags"]:checked');
      const tagIds = Array.from(tagCheckboxes).map(cb => parseInt(cb.value));

      const categoryVal = (document.getElementById('category') as HTMLSelectElement).value;
      const categoryId = categoryVal ? parseInt(categoryVal) : null;

      const body = {
        title: formData.get('title') || (document.getElementById('title') as HTMLInputElement).value,
        slug: (document.getElementById('slug') as HTMLInputElement).value,
        content: (document.getElementById('content') as HTMLTextAreaElement).value,
        coverImage: (document.getElementById('coverImage') as HTMLInputElement).value.trim() || null,
        excerpt: (document.getElementById('excerpt') as HTMLTextAreaElement).value || null,
        categoryId,
        tagIds,
        published: (document.getElementById('published') as HTMLInputElement).checked,
      };

      try {
        const resp = await fetch('/api/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (resp.ok) {
          window.location.href = '/admin/posts';
        } else {
          const data = await resp.json();
          errorEl.textContent = data.error || '保存失败';
          errorEl.classList.remove('hidden');
        }
      } catch {
        errorEl.textContent = '网络错误';
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
