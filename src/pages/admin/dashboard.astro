---
/**
 * /admin/dashboard — 管理后台概览
 */
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { prisma } from '../../lib/prisma';
import { formatDateTime } from '../../lib/utils';
import type { SessionUser } from '../../lib/auth';

const user = Astro.locals.user as SessionUser | undefined;

const [publishedCount, draftCount, categoryCount, tagCount, columnCount, announcementCount, recentPosts] = await Promise.all([
  prisma.post.count({ where: { published: true } }),
  prisma.post.count({ where: { published: false } }),
  prisma.category.count(),
  prisma.tag.count(),
  prisma.column.count(),
  prisma.announcement.count({ where: { published: true } }),
  prisma.post.findMany({ orderBy: { updatedAt: 'desc' }, take: 5,
    include: { category: { select: { name: true } } },
  }),
]);
---

<AdminLayout title="仪表盘" user={user ?? null}>
  <!-- 统计卡片 -->
  <div class="grid gap-3 sm:grid-cols-4 mb-6">
    <div class="bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)] p-4 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-muted)]">已发布</span>
        <span class="text-2xl font-bold text-[var(--color-text-primary)]">{publishedCount}</span>
      </div>
      <div class="border-t border-[var(--color-border)] pt-3 flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-muted)]">草稿</span>
        <span class="text-2xl font-bold text-yellow-500">{draftCount}</span>
      </div>
    </div>
    <div class="bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)] p-4 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-muted)]">分类</span>
        <span class="text-2xl font-bold text-[var(--color-text-primary)]">{categoryCount}</span>
      </div>
      <div class="border-t border-[var(--color-border)] pt-3 flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-muted)]">标签</span>
        <span class="text-2xl font-bold text-[var(--color-text-primary)]">{tagCount}</span>
      </div>
    </div>
    <div class="bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)] p-4 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-muted)]">专栏</span>
        <span class="text-2xl font-bold text-[var(--color-text-primary)]">{columnCount}</span>
      </div>
      <div class="border-t border-[var(--color-border)] pt-3 flex items-center justify-between">
        <span class="text-sm text-[var(--color-text-muted)]">公告</span>
        <span class="text-2xl font-bold text-[var(--color-accent)]">{announcementCount}</span>
      </div>
    </div>
    <div class="bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)] p-4 flex flex-col justify-center gap-2">
      <a href="/admin/posts/new" class="block text-center px-4 py-2.5 rounded-md bg-[var(--color-accent)] text-white text-sm hover:bg-[var(--color-accent-hover)]">+ 写文章</a>
      <a href="/" class="block text-center px-4 py-2.5 rounded-md border border-[var(--color-border)] text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)]">查看博客</a>
    </div>
  </div>

  <!-- 最近文章 -->
  <div class="bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)]">
    <div class="px-4 py-3 border-b border-[var(--color-border)] flex items-center justify-between">
      <h2 class="text-sm font-semibold text-[var(--color-text-primary)]">最近更新</h2>
      <a href="/admin/posts" class="inline-flex items-center gap-0.5 text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">更多 <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
    </div>
    {recentPosts.length === 0 ? (
      <div class="p-4 text-center text-sm text-[var(--color-text-muted)]">暂无文章</div>
    ) : (
      <div class="divide-y divide-[var(--color-border)]">
        {recentPosts.map(p => (
          <a href={`/admin/posts/${p.id}/edit`} class="flex items-center justify-between px-4 py-2.5 hover:bg-[var(--color-bg-secondary)] transition-colors">
            <div class="flex-1 min-w-0">
              <span class="text-sm text-[var(--color-text-primary)] truncate block">{p.title}</span>
              <span class="text-xs text-[var(--color-text-muted)]">
                {p.category?.name || '未分类'} · {formatDateTime(p.updatedAt)}
              </span>
            </div>
            <span class={`ml-2 px-2 py-0.5 rounded-full text-xs flex-shrink-0 ${
              p.published ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300'
            }`}>
              {p.published ? '已发布' : '草稿'}
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
