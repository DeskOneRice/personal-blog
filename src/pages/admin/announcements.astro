---
/**
 * /admin/announcements — 公告管理
 */
import AdminLayout from '../../components/layout/AdminLayout.astro';
import { prisma } from '../../lib/prisma';
import { formatDateTime } from '../../lib/utils';
import type { SessionUser } from '../../lib/auth';

const user = Astro.locals.user as SessionUser | undefined;

const announcements = await prisma.announcement.findMany({
  orderBy: { createdAt: 'desc' },
});
---

<AdminLayout title="公告管理" user={user ?? null}>
  <!-- 新建公告 -->
  <div class="mb-6 bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)] p-4">
    <h3 class="text-sm font-medium text-[var(--color-text-secondary)] mb-3">发布新公告</h3>
    <textarea id="new-content" rows="3" placeholder="公告内容 (支持 Markdown)..."
      class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] mb-2"></textarea>
    <div class="flex items-center gap-3">
      <label class="flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)]">
        <input type="checkbox" id="new-published" checked /> 立即发布
      </label>
      <button id="add-btn" class="px-4 py-1.5 rounded-md bg-[var(--color-accent)] text-white text-sm">发布</button>
    </div>
  </div>

  <!-- 公告列表 -->
  <div class="space-y-3">
    {announcements.map(a => (
      <div class="bg-[var(--color-bg-primary)] rounded-lg border border-[var(--color-border)] p-4">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="prose prose-sm text-sm text-[var(--color-text-primary)]" set:html={a.content} />
            <div class="flex items-center gap-3 mt-2 text-xs text-[var(--color-text-muted)]">
              <span>创建时间：{formatDateTime(a.createdAt)}</span>
              <span>更新时间：{formatDateTime(a.updatedAt)}</span>
              <span class={`px-1.5 py-0.5 rounded-full ${a.published ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300'}`}>
                {a.published ? '已发布' : '草稿'}
              </span>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <button class="text-sm text-[var(--color-accent)] hover:underline edit-btn"
              data-id={a.id} data-content={JSON.stringify(a.content)} data-published={a.published}>编辑</button>
            <button class="text-sm text-red-500 hover:underline delete-btn" data-id={a.id}>删除</button>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- 编辑弹窗 -->
  <dialog id="edit-dialog" class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-primary)] p-6 shadow-lg">
    <h3 class="text-lg font-semibold mb-4">编辑公告</h3>
    <input id="edit-id" type="hidden" />
    <div class="space-y-3">
      <textarea id="edit-content" rows="4" class="w-full px-3 py-2 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-primary)] text-[var(--color-text-primary)]"></textarea>
      <label class="flex items-center gap-1.5 text-sm"><input type="checkbox" id="edit-published" /> 发布</label>
      <div class="flex gap-2 justify-end">
        <button id="edit-cancel" class="px-4 py-2 rounded-md border border-[var(--color-border)] text-sm">取消</button>
        <button id="edit-save" class="px-4 py-2 rounded-md bg-[var(--color-accent)] text-white text-sm">保存</button>
      </div>
    </div>
  </dialog>

  <script>
    document.getElementById('add-btn')?.addEventListener('click', async () => {
      const content = (document.getElementById('new-content') as HTMLTextAreaElement).value.trim();
      if (!content) return alert('内容不能为空');
      const published = (document.getElementById('new-published') as HTMLInputElement).checked;
      const resp = await fetch('/api/announcements', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content, published }),
      });
      if (resp.ok) window.location.reload();
      else alert('发布失败');
    });

    const dialog = document.getElementById('edit-dialog') as HTMLDialogElement;
    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        (document.getElementById('edit-id') as HTMLInputElement).value = el.dataset.id!;
        (document.getElementById('edit-content') as HTMLTextAreaElement).value = JSON.parse(el.dataset.content!);
        (document.getElementById('edit-published') as HTMLInputElement).checked = el.dataset.published === 'true';
        dialog.showModal();
      });
    });
    document.getElementById('edit-cancel')?.addEventListener('click', () => dialog.close());
    document.getElementById('edit-save')?.addEventListener('click', async () => {
      const id = (document.getElementById('edit-id') as HTMLInputElement).value;
      const resp = await fetch(`/api/announcements?id=${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          content: (document.getElementById('edit-content') as HTMLTextAreaElement).value.trim(),
          published: (document.getElementById('edit-published') as HTMLInputElement).checked,
        }),
      });
      if (resp.ok) window.location.reload();
      else alert('更新失败');
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('删除这条公告？')) return;
        const el = btn as HTMLElement;
        const resp = await fetch(`/api/announcements?id=${el.dataset.id}`, { method: 'DELETE' });
        if (resp.ok) window.location.reload();
        else alert('删除失败');
      });
    });
  </script>
</AdminLayout>
