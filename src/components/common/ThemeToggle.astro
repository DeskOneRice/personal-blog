---
---

<button
  id="theme-toggle"
  type="button"
  class="p-2 rounded-lg text-[var(--color-text-primary)] hover:text-[var(--color-accent)] hover:bg-[var(--color-bg-secondary)] transition-colors"
  aria-label="切换暗色模式"
>
  <!-- 太阳图标 (亮色模式) -->
  <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- 月亮图标 (暗色模式) -->
  <svg id="theme-icon-dark" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  // 这个 script 只在浏览器端执行（因为 client:load）
  const toggle = document.getElementById('theme-toggle');
  const iconLight = document.getElementById('theme-icon-light');
  const iconDark = document.getElementById('theme-icon-dark');

  function updateIcon() {
    // 显示当前状态对应的图标：暗色→月亮，亮色→太阳
    const isDark = document.documentElement.classList.contains('dark');
    if (iconLight) iconLight.style.display = isDark ? 'none' : 'block';
    if (iconDark) iconDark.style.display = isDark ? 'block' : 'none';
  }

  // 初始状态
  updateIcon();

  // 点击切换
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    if (html.classList.contains('dark')) {
      html.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      html.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateIcon();
  });
</script>
