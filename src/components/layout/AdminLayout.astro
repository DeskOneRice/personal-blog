---
/**
 * AdminLayout.astro — 管理后台布局
 *
 * 比公开页面更简洁，专注功能。
 * 如果用户未登录，显示登录页；登录后显示后台导航 + 内容。
 */
import SEO from '../common/SEO.astro';
import AdminNav from '../admin/AdminNav.astro';
import type { SessionUser } from '../../lib/auth';

export interface Props {
  title?: string;
  user?: SessionUser | null;  // 从 middleware 注入
}

const { title = '管理后台', user } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="min-h-screen bg-[var(--color-bg-secondary)]">
    {user ? (
      <div class="flex min-h-screen">
        <!-- 侧边导航 -->
        <aside class="w-56 bg-[var(--color-bg-primary)] border-r border-[var(--color-border)] p-4 flex-shrink-0">
          <div class="mb-6">
            <a href="/admin/dashboard" class="text-lg font-bold text-[var(--color-text-primary)]">
              管理后台
            </a>
            <p class="text-xs text-[var(--color-text-muted)] mt-1">
              欢迎，管理员 <span class="text-[var(--color-accent)]">{user.username}</span>
            </p>
          </div>
          <AdminNav />
          <div class="mt-6 pt-4 border-t border-[var(--color-border)]">
            <a href="/" class="inline-flex items-center gap-1 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            返回博客
          </a>
          </div>
        </aside>
        <!-- 主内容区 -->
        <main class="flex-1 p-6">
          <h1 class="text-2xl font-bold text-[var(--color-text-primary)] mb-6">{title}</h1>
          <slot />
        </main>
      </div>
    ) : (
      <div class="flex items-center justify-center min-h-screen px-4">
        <slot />
      </div>
    )}
  </body>
</html>
