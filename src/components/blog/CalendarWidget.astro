---
/**
 * CalendarWidget.astro — 签到日历（支持月份切换）
 *
 * 服务端查询文章日期，客户端渲染日历 + 前后月切换。
 * 活跃度 = 当天发布的文章数，颜色越深越活跃。
 */
import { prisma } from '../../lib/prisma';

const posts = await prisma.post.findMany({
  where: { published: true },
  select: { createdAt: true },
});

const bjFmt = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' });

const activityMap = new Map<string, number>();
for (const post of posts) {
  const key = bjFmt.format(post.createdAt).replace(/\//g, '-'); // 2026/06/10 → 2026-06-10
  activityMap.set(key, (activityMap.get(key) || 0) + 1);
}
const activityJSON = JSON.stringify(Object.fromEntries(activityMap));

const now = new Date();
const todayKey = bjFmt.format(now).replace(/\//g, '-');
---

<div
  id="calendar-widget"
  class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4"
  data-activity={activityJSON}
  data-today={todayKey}
>
  <!-- 标题栏 + 箭头 -->
  <div class="flex items-center justify-between mb-3 pb-2 border-b border-[var(--color-border)]">
    <button id="cal-prev" class="p-1 rounded hover:bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors" aria-label="上个月">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <h3 id="cal-title" class="text-sm text-[var(--color-text-secondary)]">📅</h3>
    <button id="cal-next" class="p-1 rounded hover:bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors" aria-label="下个月">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>

  <!-- 星期标签 -->
  <div class="grid grid-cols-7 gap-1 mb-1" id="cal-weekdays"></div>

  <!-- 日期格子 -->
  <div class="grid grid-cols-7 gap-1" id="cal-grid"></div>

  <!-- 图例 -->
  <div id="cal-legend" class="flex items-center justify-end gap-1 mt-3 text-xs text-[var(--color-text-muted)]">
    <span>少</span>
    <div class="legend-item w-3 h-3 rounded-sm bg-[var(--color-bg-secondary)] border border-[var(--color-border)]" title="0 篇"></div>
    <div class="legend-item w-3 h-3 rounded-sm bg-primary-100 dark:bg-primary-900/40" title="1 篇"></div>
    <div class="legend-item w-3 h-3 rounded-sm bg-primary-200 dark:bg-primary-800/60" title="2 篇"></div>
    <div class="legend-item w-3 h-3 rounded-sm bg-primary-400 dark:bg-primary-600" title="3 篇"></div>
    <div class="legend-item w-3 h-3 rounded-sm bg-primary-500 dark:bg-primary-500" title="4+ 篇"></div>
    <span>多</span>
  </div>
</div>

<script>
  const widget = document.getElementById('calendar-widget')!;
  const activity: Record<string, number> = JSON.parse(widget.dataset.activity || '{}');
  const todayStr: string = widget.dataset.today || '';

  const weekDays = ['日', '一', '二', '三', '四', '五', '六'];

  const styles = [
    'bg-[var(--color-bg-secondary)] text-[var(--color-text-secondary)]',
    'bg-primary-100 dark:bg-primary-900/40 text-[var(--color-text-secondary)]',
    'bg-primary-200 dark:bg-primary-800/60 text-[var(--color-text-secondary)]',
    'bg-primary-400 dark:bg-primary-600 text-white',
    'bg-primary-500 dark:bg-primary-500 text-white',
  ];

  // 初始显示当前月
  const now = new Date();
  let viewYear = now.getFullYear();
  let viewMonth = now.getMonth(); // 0-indexed

  function getActivity(date: number): number {
    const key = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(date).padStart(2, '0')}`;
    const count = activity[key] || 0;
    // 固定阈值：0篇=灰，1篇=浅蓝，2篇=中蓝，3篇=深蓝，4+篇=最深蓝
    if (count === 0) return 0;
    if (count === 1) return 1;
    if (count === 2) return 2;
    if (count === 3) return 3;
    return 4;
  }

  function render() {
    // 标题
    document.getElementById('cal-title')!.textContent = `📅 ${viewYear}年${viewMonth + 1}月`;

    // 星期标签
    document.getElementById('cal-weekdays')!.innerHTML = weekDays
      .map(d => `<div class="text-center text-xs text-[var(--color-text-muted)] py-1">${d}</div>`)
      .join('');

    // 日历格子
    const firstDay = new Date(viewYear, viewMonth, 1).getDay();
    const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

    let html = '';
    // 前置空白
    for (let i = 0; i < firstDay; i++) {
      html += '<div class="aspect-square"></div>';
    }
    // 日期
    for (let d = 1; d <= daysInMonth; d++) {
      const level = getActivity(d);
      const key = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const isToday = key === todayStr;
      const count = activity[key] || 0;
      const tip = count === 0 ? '无发布' : `${count} 篇文章`;

      html += `<div class="aspect-square rounded-md flex items-center justify-center text-xs font-medium cursor-default transition-colors ${styles[level]} ${isToday ? 'ring-2 ring-[var(--color-accent)] ring-offset-1 font-bold' : ''}" title="${viewMonth + 1}月${d}日 · ${tip}">${d}</div>`;
    }

    document.getElementById('cal-grid')!.innerHTML = html;
  }

  // 月份切换
  document.getElementById('cal-prev')!.addEventListener('click', () => {
    if (viewMonth === 0) { viewYear--; viewMonth = 11; }
    else { viewMonth--; }
    render();
  });
  document.getElementById('cal-next')!.addEventListener('click', () => {
    if (viewMonth === 11) { viewYear++; viewMonth = 0; }
    else { viewMonth++; }
    render();
  });

  // 首屏渲染
  render();
</script>
