---
/**
 * CategoryWidget.astro — 分类概览
 */
import { prisma } from '../../lib/prisma';

const categories = await prisma.category.findMany({
  include: { _count: { select: { posts: { where: { published: true } } } } },
  orderBy: { sortOrder: 'asc' },
});

if (categories.length === 0) return;
---

<div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4">
  <h3 class="text-sm text-[var(--color-text-secondary)] mb-3 pb-2 border-b border-[var(--color-border)] flex items-center justify-between">
    <span>📁 分类</span>
    <a href="/categories/" class="inline-flex items-center gap-0.5 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] text-xs transition-colors">
      更多 <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </h3>
  <div class="space-y-1.5">
    {categories.map(cat => (
      <a
        href={`/categories/${cat.slug}`}
        class="flex items-center justify-between text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors"
      >
        <span>{cat.name}</span>
        <span class="text-xs text-[var(--color-text-muted)] bg-[var(--color-bg-secondary)] px-2 py-0.5 rounded-full">
          {cat._count.posts}
        </span>
      </a>
    ))}
  </div>
</div>
