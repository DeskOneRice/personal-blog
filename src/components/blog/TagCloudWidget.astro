---
/**
 * TagCloudWidget.astro — 标签概览
 */
import { prisma } from '../../lib/prisma';

const tags = await prisma.tag.findMany({
  include: {
    _count: { select: { posts: { where: { post: { published: true } } } } },
  },
  orderBy: { name: 'asc' },
  take: 20,
});

if (tags.length === 0) return;
---

<div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4">
  <h3 class="text-sm text-[var(--color-text-secondary)] mb-3 pb-2 border-b border-[var(--color-border)] flex items-center justify-between">
    <span>🏷️ 标签</span>
    <a href="/tags/" class="inline-flex items-center gap-0.5 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] text-xs transition-colors">
      更多 <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </h3>
  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <a
        href={`/tags/${tag.slug}`}
        class="inline-block px-2.5 py-1 rounded-full text-xs border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] hover:bg-[var(--color-accent)]/5 transition-all"
      >
        {tag.name}
        <span class="ml-1 text-[var(--color-text-muted)]">{tag._count.posts}</span>
      </a>
    ))}
  </div>
</div>
