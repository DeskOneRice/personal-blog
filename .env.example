# ============================================================
# 个人博客 — 环境变量说明
# 复制此文件为 .env 并修改对应值
# ============================================================

# 数据库路径 (SQLite 文件位置)
DATABASE_URL="file:./data/blog.db"

# 站点 URL (生产环境改为真实域名，如 https://yourdomain.com)
SITE_URL="http://localhost:4321"

# Session 加密密钥 (生产环境务必修改为随机字符串！)
# 生成方法: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# ============================================================
# Giscus 评论区配置 (可选)
# 1. 在 https://github.com/apps/giscus 安装 Giscus
# 2. 在仓库 Settings > Features 启用 Discussions
# 3. 访问 https://giscus.app 获取以下配置值
# ============================================================
# GISCUS_REPO="your-username/your-repo"
# GISCUS_REPO_ID="MDEwOlJlcG9zaXRvcnk..."
# GISCUS_CATEGORY="Announcements"
# GISCUS_CATEGORY_ID="DIC_kwDO..."
